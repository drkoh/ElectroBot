<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Top Row: Left Info & Right Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Queue and Timestamp -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_queue_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#2.2"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bulb_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 💡"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:paddingStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Станом на 21:44"
                android:textColor="#FF9F0A"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Right: Status and Time Remaining -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вимкнено"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:gravity="end" />

            <TextView
                android:id="@+id/widget_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Відновиться через ~45хв"
                android:textColor="#FF9F0A"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: Custom Timeline Canvas -->
    <ImageView
        android:id="@+id/widget_timeline_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:scaleType="fitXY"
        android:contentDescription="Графік погодинних відключень" />

</LinearLayout>
